# Disabled by default. Only true enables privacy controls; tracking also needs a valid GA4 ID.
NUXT_PUBLIC_ANALYTICS_ENABLED=false
# Public GA4 measurement ID. Configure the real value only for enabled production tracking.
# Public runtime configuration is visible in the browser; do not put secrets here.
NUXT_PUBLIC_GTAG_ID=G-XXXXXXXXXX
# Optional public notification address, never a secret. Empty shows the general location.
# A general location does not fulfill the legal requirement for a complete notification address.
NUXT_PUBLIC_PRIVACY_ADDRESS=
# Public Calendly booking link. Empty or invalid hides the scheduling action.
NUXT_PUBLIC_CALENDLY_URL=
# Development only: MX shows the action locally; another code or empty hides it.
# Ignored in production builds, where the Netlify Edge Function decides visibility.
NUXT_SCHEDULING_TEST_COUNTRY=
